# Generic LLM provider config — works with OpenRouter or any other
# OpenAI-compatible chat-completions endpoint. Not tied to one vendor:
# swap LLM_BASE_URL/LLM_MODEL to point at a different provider without
# touching code.

# Which LLM backend Aftermind's reconciliation/consolidation uses. Run
# `aftermind init` to pick interactively; it detects existing logins:
#   openai_compatible   LLM_BASE_URL + LLM_API_KEY + LLM_MODEL (default)
#   codex_oauth         reuse the Codex CLI's ChatGPT login (~/.codex/auth.json)
#   claude_code_oauth   reuse the Claude Code login (Keychain / ~/.claude)
LLM_PROVIDER=openai_compatible

# Get a key at https://openrouter.ai/keys (or your provider of choice).
LLM_API_KEY=

# Any model slug your provider supports, e.g. "openai/gpt-4o-mini",
# "anthropic/claude-sonnet-5", "google/gemini-2.5-flash".
LLM_MODEL=

# Defaults to OpenRouter; point elsewhere for a different
# OpenAI-compatible gateway (self-hosted, another vendor, etc).
LLM_BASE_URL=https://openrouter.ai/api/v1

# Phase 1 durable store: SQLite file path (experiences, memories,
# checkpoints, memory decisions, lifecycle metadata). Postgres/
# OpenKnowledge come in later phases behind the same interfaces —
# nothing above core/ changes when they land.
DATABASE_PATH=./aftermind.db

# Phase 2 durable store: Graphiti + Neo4j for entities/relationships.
# Leave NEO4J_PASSWORD empty to fall back to the in-process GraphStore.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# Seconds before a graph read/write against an unreachable Neo4j gives up
# (the failure is recorded in the durable sync outbox and retried).
NEO4J_TIMEOUT_SECONDS=5
# Per-query server-side cap for graph reads during recall, so a graph busy
# with writes/index builds can't push recall past the hook timeout.
NEO4J_QUERY_TIMEOUT_SECONDS=2

# Phase 3: OpenKnowledge for consolidated, human-readable knowledge
# (the Consolidation Engine's output — not every StoredMemory). Point
# at a running `ok start` / OK Desktop server's API port. Leave empty
# to fall back to a local markdown directory (./openknowledge_store).
OPENKNOWLEDGE_URL=

# --- Memory admission (what gets stored) --------------------------------
# See docs/memory-policy.md. A deterministic gate always runs (questions,
# directives, greetings, tool output, code, markup, secrets never become
# memories). Then:
#   auto   use the LLM admission stage when an LLM is configured (recommended)
#   llm    always use it (extracts atomic facts from long text, scores them)
#   rules  never call the LLM for admission; store gate-admitted text as-is
AFTERMIND_ADMISSION_MODE=auto
# Minimum usefulness AND durability (each) for a candidate to be stored, 0-1.
AFTERMIND_MEMORY_MIN_SCORE=0.5
# Longer text is never stored verbatim; the LLM must extract atomic facts.
AFTERMIND_MAX_CANDIDATE_CHARS=600

# --- Reliability / runtime ---------------------------------------------

# How graph (Neo4j) and document (OpenKnowledge) writes are propagated
# from the canonical SQLite store. Both modes write a durable sync job in
# the same transaction as the memory.
#   eager       try the secondary write immediately; on failure the job
#               stays pending and the background worker retries it.
#   background  never write secondaries inline; the worker does all of it
#               (lowest observe() latency, graph lags by ~poll interval).
AFTERMIND_SYNC_MODE=eager

# Run the outbox worker inside the API process (true) or separately via
# `aftermind worker` (set false here).
AFTERMIND_SYNC_WORKER=true
AFTERMIND_SYNC_POLL_SECONDS=2
AFTERMIND_SYNC_BATCH_SIZE=10
# Retries before a job is marked dead (exponential backoff, 1s..5min).
AFTERMIND_SYNC_MAX_ATTEMPTS=10
# A job left "running" longer than this is assumed orphaned by a crash.
AFTERMIND_SYNC_STALE_RUNNING_SECONDS=600
# Eager mode: how long observe() waits for a graph/document write before
# returning with that store marked `pending` (the write keeps going).
AFTERMIND_SYNC_EAGER_TIMEOUT_SECONDS=15

# Logging: level and format (text for terminals, json for log shippers).
# Every operation emits one trace line on the `aftermind.trace` logger.
AFTERMIND_LOG_LEVEL=INFO
AFTERMIND_LOG_FORMAT=text
# Recent traces kept in memory for GET /traces.
AFTERMIND_TRACE_BUFFER=200

AFTERMIND_HOST=0.0.0.0
AFTERMIND_PORT=8000
